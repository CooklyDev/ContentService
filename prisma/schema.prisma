// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider               = "prisma-client"
  output                 = "../src/adapters/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id              String @id
  userId          String
  name            String
  description     String?
  instructions    String
  calories        Int?
  proteins        Int?
  carbohydrates   Int?
  preparationTime Int?
  cookTime        Int?
  complexity      Int?
}

model Collection {
  id          String @id
  userId      String
  name        String
  description String?
  recipes     CollectionRecipe[]
}

model CollectionRecipe {
  collectionId String
  recipeId     String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, recipeId])
}
